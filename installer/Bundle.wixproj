<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>UFC-Event-Host-Finder-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <DefineConstants>AppVersion=$(Version)</DefineConstants>

    <!-- The MSI source lives in this folder too; compile only this project's files. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

</Project>
