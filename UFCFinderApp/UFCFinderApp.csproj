<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UFCFinderApp</RootNamespace>
    <AssemblyName>UFCFinderApp</AssemblyName>
    <ApplicationIcon>ufc.ico</ApplicationIcon>
    <Product>UFC Event Host Finder</Product>
    <AssemblyTitle>UFC Event Host Finder</AssemblyTitle>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ufc.ico" />
  </ItemGroup>

</Project>
